{
  "name": "medicore-hospital-management-system",
  "version": "1.0.0",
  "description": "MediCore HMS - Advanced Hospital Management System tailored for Sri Lanka (React, Node.js, MySQL)",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client\"",
    "server": "npm run start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "db:setup": "node server/src/setupDb.js"
  },
  "keywords": [
    "hospital-management-system",
    "sri-lanka",
    "react",
    "nodejs",
    "mysql",
    "hms",
    "channelling",
    "emr",
    "pharmacy",
    "laboratory"
  ],
  "author": "MediCore Health Systems Sri Lanka",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
